# Copy to .env.local for local dev, and add the same vars in Vercel → Project → Settings → Environment Variables.

# Public site settings
NEXT_PUBLIC_SITE_URL=https://commoncodestudios.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@commoncodestudios.com
# Optional Cal.com / Calendly link; leave empty to hide
NEXT_PUBLIC_SCHEDULING_URL=

# Contact form (https://resend.com, free tier)
RESEND_API_KEY=
# Where inquiries are delivered (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Common Code Studios <contact@commoncodestudios.com>"
CONTACT_FROM_EMAIL=
